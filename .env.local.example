# ⚠️ SECURITY: Never commit .env.local to git!
# This file shows what variables you need.
# Copy to .env.local and fill with YOUR values ONLY

# Smart Contract Addresses (from Remix deployment)
NEXT_PUBLIC_REP_CONTRACT=0x...
NEXT_PUBLIC_CREDIT_CONTRACT=0x...
NEXT_PUBLIC_COPY_VAULT_CONTRACT=0x...

# PRIVATE KEYS (ONLY in .env.local, NEVER in git)
# These are for local development only
PRIVATE_KEY_DEPLOYER=0x...
PRIVATE_KEY_ADMIN=0x...

# RPC Endpoints (public, safe to share)
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=84532

# Wallet/App Configuration
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here
